# Intelligence Stronghold — server-side config (COPY TO .env, never commit .env)
# Shared secret the frontend sends as the `x-stronghold-token` header.
# The API route rejects any request whose token != this value.
STRONGHOLD_TOKEN=change-me-to-a-long-random-string

# Where the stronghold doc store is written (absolute path, off the repo).
# Defaults to c:/vis-intel. The file stronghold.json is created here.
STRONGHOLD_DATA_DIR=c:/vis-intel
